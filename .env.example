# App URL (used for redirects and as the base for building absolute URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser calls go to the same-origin proxy /api/v1 (see src/app/api/v1/[...path]/route.ts),
# which injects the Auth0 access token and forwards to the Nest backend. Keep this as /api/v1.
NEXT_PUBLIC_BACKEND_API_URL=/api/v1

# Where the /api/v1 proxy forwards to (server-side only). Must include /v1.
BACKEND_API_URL=http://localhost:3001/v1

# ─────────────────────────── Auth0 (SDK v4) ───────────────────────────
# Use the allatura-dev tenant locally and allatura-prod in production.
#
# The tenant domain, e.g. allatura-dev.us.auth0.com (NO https://).
AUTH0_DOMAIN=allatura-dev.us.auth0.com
# Regular Web Application credentials from the Auth0 dashboard.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte secret used to encrypt the session cookie. Generate with:
#   openssl rand -hex 32
AUTH0_SECRET=
# This app's origin. In prod set to your deployed frontend origin (https://...).
APP_BASE_URL=http://localhost:3000
# API Identifier of the Allatura backend API in Auth0 — must match the
# backend's AUTH0_AUDIENCE so the access token is accepted by Nest.
AUTH0_AUDIENCE=https://api.allatura.app
# Scopes requested at login. offline_access enables silent token refresh.
AUTH0_SCOPE=openid profile email offline_access

# --- Production example (set these in your host's env UI before `next build`) ---
# NEXT_PUBLIC_APP_URL=https://your-frontend.example.com
# BACKEND_API_URL=https://plutus-api-462298977190.us-central1.run.app/v1
# APP_BASE_URL=https://your-frontend.example.com
# AUTH0_DOMAIN=allatura-prod.us.auth0.com

# Optional legacy API key header (unused with Auth0; kept for compatibility)
BACKEND_API_KEY=

# ─────────────────────────── Stripe ───────────────────────────
# Stripe is owned ENTIRELY by the backend (plutus-be). The frontend holds NO
# Stripe secrets: it calls POST /v1/billing/checkout (via the proxy) and
# redirects to the URL the backend returns. Webhooks hit the backend only.
# Put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_* / BILLING_MODE
# in plutus-be, NOT here.
#
# Optional: only needed if you ever embed Stripe.js on the frontend (Payment
# Element etc.). Not required for the current backend-hosted checkout redirect.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

NODE_ENV=development
